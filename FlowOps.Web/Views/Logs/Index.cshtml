@model IReadOnlyList<FlowOps.Web.Controllers.PortalLogEvent>

@{
    ViewData["Title"] = "Logs";
}

<div class="logs-hero">
    <div>
        <div class="eyebrow">Observability</div>
        <h1>FlowOps Logs Viewer</h1>
        <p>
            A live operational events view for the FlowOps delivery cycle.
            It reads platform state from deployment history, Kubernetes, ArgoCD and Prometheus services.
        </p>
    </div>
    <div class="logs-badge">
        <i class="ti ti-terminal-2"></i>
        Live Events
    </div>
</div>

<div class="logs-grid">
    <div class="logs-card">
        <div class="logs-card-icon"><i class="ti ti-rocket"></i></div>
        <div>
            <h3>Deployment Events</h3>
            <p>Reads recent deployment history from the FlowOps deployment service.</p>
        </div>
    </div>

    <div class="logs-card">
        <div class="logs-card-icon"><i class="ti ti-brand-kubernetes"></i></div>
        <div>
            <h3>Kubernetes Events</h3>
            <p>Summarizes the current running applications and active replicas.</p>
        </div>
    </div>

    <div class="logs-card">
        <div class="logs-card-icon"><i class="ti ti-activity"></i></div>
        <div>
            <h3>Monitoring Events</h3>
            <p>Reads ArgoCD sync state and Prometheus alert status.</p>
        </div>
    </div>
</div>

<div class="logs-panel">
    <div class="logs-panel-head">
        <div>
            <h2>Live Operational Events</h2>
            <p>Generated from the current FlowOps platform state.</p>
        </div>
        <span class="logs-live"><span></span> Live Data</span>
    </div>

    <div class="logs-table">
        @foreach (var log in Model)
        {
            var levelClass = log.Level.ToLowerInvariant();
            <div class="log-row">
                <div class="log-time">@log.Time.ToLocalTime().ToString("HH:mm:ss")</div>
                <div class="log-level @levelClass">@log.Level</div>
                <div class="log-source">@log.Source</div>
                <div class="log-message">@log.Message</div>
            </div>
        }
    </div>
</div>

<div class="logs-note">
    <i class="ti ti-info-circle"></i>
    <span>
        This page shows live operational events from the FlowOps application services.
        Full raw centralized logging using Loki, Promtail or ELK is planned as future work.
    </span>
</div>
