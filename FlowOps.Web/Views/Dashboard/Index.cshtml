@model FlowOps.Core.DTOs.DashboardSummaryDto
@{ ViewData["Title"] = "Dashboard"; }

<div style="display:flex;flex-direction:column;gap:14px">
  <div class="g4">
    <div class="sc ok"><div class="sc-lbl"><i class="ti ti-apps"></i>Running apps</div><div class="sc-num">@Model.RunningApps</div><div class="sc-sub" style="color:var(--okt)"><span class="pu pu-ok"></span>All healthy</div></div>
    <div class="sc in"><div class="sc-lbl"><i class="ti ti-rocket"></i>Deploys today</div><div class="sc-num">@Model.DeploymentsToday</div><div class="sc-sub" style="color:var(--int)"><span class="pu pu-in"></span>Live</div></div>
    <div class="sc wa"><div class="sc-lbl"><i class="ti ti-server"></i>Active pods</div><div class="sc-num">@Model.ActivePods</div><div class="sc-sub" style="color:var(--t2)">3 namespaces</div></div>
    <div class="sc ac"><div class="sc-lbl"><i class="ti ti-clock-bolt"></i>Avg deploy time</div><div class="sc-num">@TimeSpan.FromSeconds(Model.AvgDeploySeconds).ToString(@"m\m\ ss\s")</div><div class="sc-sub" style="color:var(--okt)"><i class="ti ti-arrow-down" style="font-size:11px"></i>Faster</div></div>
  </div>

  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px">
    <div class="card"><div style="padding:14px 16px">
      <div class="sc-lbl"><i class="ti ti-cpu"></i>CPU</div>
      <div class="sc-num" id="cpu-val">@Model.CpuPercent%</div>
      <div class="pb"><div class="pf" id="cpu-bar" style="width:@Model.CpuPercent%;background:var(--ok)"></div></div>
      <div style="height:50px;margin-top:6px"><canvas id="c-cpu"></canvas></div>
    </div></div>
    <div class="card"><div style="padding:14px 16px">
      <div class="sc-lbl"><i class="ti ti-database"></i>Memory</div>
      <div class="sc-num" id="mem-val">@Model.MemoryPercent%</div>
      <div class="pb"><div class="pf" id="mem-bar" style="width:@Model.MemoryPercent%;background:var(--wa)"></div></div>
      <div style="height:50px;margin-top:6px"><canvas id="c-mem"></canvas></div>
    </div></div>
    <div class="card"><div style="padding:14px 16px">
      <div class="sc-lbl"><i class="ti ti-network"></i>Req / s</div>
      <div class="sc-num" id="net-val">@Model.NetworkMbps</div>
      <div class="pb"><div class="pf" style="width:@(Math.Min(Model.NetworkMbps/4*10,100))%;background:var(--in)"></div></div>
      <div style="height:50px;margin-top:6px"><canvas id="c-net"></canvas></div>
    </div></div>
  </div>

  <div class="g2">
    <div class="card">
      <div class="ch"><span class="ct"><i class="ti ti-apps"></i>Applications</span><a class="bsm" asp-controller="Environments" asp-action="Index">Environments ↗</a></div>
      @foreach (var app in Model.Applications)
      {
        <div class="ri">
          <div class="ai" style="background:var(--acc3);color:var(--acc2)">@(app.Name.Length>=2?app.Name[..2].ToUpper():"??")</div>
          <div style="flex:1;min-width:0">
            <div style="font-size:13px;font-weight:500;color:var(--t)">@app.Name</div>
            <div style="font-size:11px;color:var(--t2)">@app.Environment · @app.CurrentVersion · @app.ReplicaCount pods</div>
          </div>
          @if (app.Status == AppStatus.Running)       { <span class="pill p-ok"><span class="pu pu-ok"></span>Running</span> }
          else if (app.Status == AppStatus.Deploying) { <span class="pill p-in"><span class="pu pu-in"></span>Deploying</span> }
          else                                         { <span class="pill p-er"><span class="pu pu-er"></span>Failed</span> }
        </div>
      }
    </div>

    <div class="card">
      <div class="ch"><span class="ct"><i class="ti ti-git-commit"></i>Deployment timeline</span><a class="bsm" asp-controller="History" asp-action="Index">All ↗</a></div>
      @foreach (var dep in Model.RecentDeployments)
      {
        var dotColor = dep.Status switch { DeploymentStatus.Success=>"var(--ok)", DeploymentStatus.Running=>"var(--in)", _=>"var(--er)" };
        <div class="tl">
          <div class="tll"><div class="tld" style="background:@dotColor"></div>@if(dep!=Model.RecentDeployments.Last()){<div class="tln"></div>}</div>
          <div style="flex:1;min-width:0">
            <div style="font-size:13px;font-weight:500;color:var(--t)">@dep.AppName → @dep.TargetVersion</div>
            <div style="font-size:11px;color:var(--t2);margin-top:2px">@dep.TriggeredBy · @dep.Environment @if(!string.IsNullOrEmpty(dep.CommitHash)){<span style="font-family:monospace;font-size:10px;background:var(--bg3);padding:1px 5px;border-radius:4px">@dep.CommitHash</span>}</div>
          </div>
          <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
            @if(dep.Status==DeploymentStatus.Success){<span class="pill p-ok">Success</span>}
            else if(dep.Status==DeploymentStatus.Running){<span class="pill p-in"><span class="pu pu-in"></span>Running</span>}
            else{<span class="pill p-er">@dep.Status</span>}
            <span style="font-size:11px;color:var(--t3)">@GetTimeAgo(dep.StartedAt)</span>
          </div>
        </div>
      }
    </div>
  </div>

  <div class="card">
    <div class="ch"><span class="ct"><i class="ti ti-list"></i>Activity feed</span><span style="font-size:11px;color:var(--ok);display:flex;align-items:center;gap:4px"><span class="pu pu-ok"></span>Live</span></div>
    <div class="ri"><div style="width:28px;height:28px;border-radius:6px;background:var(--inb);color:var(--in);display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0"><i class="ti ti-git-branch"></i></div><div style="flex:1"><div style="font-size:13px;color:var(--t)">ArgoCD detected new commit on <strong>main</strong></div><div style="font-size:11px;color:var(--t2)">product-service · just now</div></div><span class="pill p-in">Sync</span></div>
    <div class="ri"><div style="width:28px;height:28px;border-radius:6px;background:var(--okb);color:var(--ok);display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0"><i class="ti ti-check"></i></div><div style="flex:1"><div style="font-size:13px;color:var(--t)">Health check passed — all pods ready</div><div style="font-size:11px;color:var(--t2)">user-service · 20m ago</div></div><span class="pill p-ok">Healthy</span></div>
    <div class="ri"><div style="width:28px;height:28px;border-radius:6px;background:var(--erb);color:var(--er);display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0"><i class="ti ti-alert-triangle"></i></div><div style="flex:1"><div style="font-size:13px;color:var(--t)">Liveness probe failed — rollback triggered</div><div style="font-size:11px;color:var(--t2)">product-service · 3h ago</div></div><span class="pill p-er">Alert</span></div>
  </div>
</div>

@functions {
  string GetTimeAgo(DateTime dt) { var d=DateTime.UtcNow-dt; if(d.TotalMinutes<1) return "just now"; if(d.TotalMinutes<60) return $"{(int)d.TotalMinutes}m ago"; if(d.TotalHours<24) return $"{(int)d.TotalHours}h ago"; return dt.ToString("MMM d"); }
}

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
function mkSpark(id,color){
  const ctx=document.getElementById(id);if(!ctx)return;
  const data=Array.from({length:9},()=>Math.round(20+Math.random()*60));
  new Chart(ctx,{type:'line',data:{labels:data.map((_,i)=>i),datasets:[{data,borderColor:color,borderWidth:1.5,pointRadius:0,fill:true,backgroundColor:color+'22',tension:.4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{enabled:false}},scales:{x:{display:false},y:{display:false,min:0,max:100}},animation:{duration:400}}});
}
mkSpark('c-cpu','#10b981');mkSpark('c-mem','#f59e0b');mkSpark('c-net','#3b82f6');
setInterval(async()=>{
  const r=await fetch('/api/dashboard/metrics');const d=await r.json();
  document.getElementById('cpu-val').textContent=d.cpu+'%';
  document.getElementById('mem-val').textContent=d.mem+'%';
  document.getElementById('net-val').textContent=d.rps;
  document.getElementById('cpu-bar').style.width=d.cpu+'%';
  document.getElementById('mem-bar').style.width=d.mem+'%';
},30_000);
</script>
}
