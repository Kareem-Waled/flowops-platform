@{ ViewData["Title"] = "Error"; }
<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:400px;gap:16px;text-align:center">
  <div style="width:56px;height:56px;border-radius:14px;background:var(--erb);display:flex;align-items:center;justify-content:center"><i class="ti ti-alert-triangle" style="font-size:28px;color:var(--er)"></i></div>
  <div><div style="font-size:18px;font-weight:500;color:var(--t)">Something went wrong</div><div style="font-size:13px;color:var(--t2);margin-top:6px">An unexpected error occurred. Please try again or check the logs.</div></div>
  <a asp-controller="Dashboard" asp-action="Index" class="btn-p"><i class="ti ti-arrow-left"></i>Back to Dashboard</a>
</div>
